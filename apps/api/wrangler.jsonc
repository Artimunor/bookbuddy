{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookbuddy-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookbuddy-local",
      "migrations_dir": "migrations"
    }
  ],
  // Provision EVIDENCE with public bucket access disabled; grants are scoped by the API.
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "bookbuddy-evidence-local" }],
  "queues": {
    "producers": [{ "binding": "EFFECTS", "queue": "bookbuddy-effects-local" }],
    "consumers": [{ "queue": "bookbuddy-effects-local" }]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveTopic" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveTopic"] }],
  "triggers": { "crons": ["* * * * *"] }
  // Configure PUBLIC_APP_ORIGIN as the public HTTPS origin for invitation links.
  // Deployment secrets for feature waves (names only; never configure values here):
  // OTP_HMAC_KEY, EFFECTS_ENCRYPTION_KEY, SYNC_CURSOR_HMAC_KEY,
  // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, POSTMARK_SERVER_TOKEN,
  // GOOGLE_TRANSLATION_CREDENTIAL (only when an approved translation pair is enabled).
}
