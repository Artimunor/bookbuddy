{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookbuddy-api",
  // Set the BookBuddy Cloudflare account ID here and in the web Worker config.
  "account_id": "<CLOUDFLARE_ACCOUNT_ID>",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookbuddy-db",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  // Provision EVIDENCE with public bucket access disabled; grants are scoped by the API.
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "bookbuddy-evidence" }],
  "queues": {
    "producers": [{ "binding": "EFFECTS", "queue": "bookbuddy-effects" }],
    "consumers": [{ "queue": "bookbuddy-effects" }]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveTopic" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveTopic"] }],
  "triggers": { "crons": ["* * * * *"] },
  // Production vars; override locally in the ignored .dev.vars.
  "vars": {
    "PUBLIC_APP_ORIGIN": "<PUBLIC_APP_ORIGIN>",
    "R2_ACCOUNT_ID": "<CLOUDFLARE_ACCOUNT_ID>",
    "R2_EVIDENCE_BUCKET": "bookbuddy-evidence",
    "POSTMARK_SENDER": "<POSTMARK_SENDER>"
  }
}
