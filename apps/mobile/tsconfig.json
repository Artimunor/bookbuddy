{
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],
    "moduleSuffixes": [".native", ""]
  },
  "include": ["index.ts", "app.config.ts", "src/**/*.ts", "src/**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test-kit.ts"]
}
